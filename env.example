# Port ya Server
PORT=3000

# URL ya Website yako (Inayotoka Render au domain yako halisi)
APP_URL=https://my-global-learning-platform.onrender.com

# Database Connection URL
DATABASE_URL=mysql://username:password@hostname:port/database_name

# OpenRouter AI API Key
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# HarakaPay Payment API Key
HARAKAPAY_API_KEY=hpk_your_harakapay_api_key_here
HARAKAPAY_BASE_URL=https://harakapay.net

# Admin Panel Credentials za Awali
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_hashed_password

